*.pak
*.utoc
*.ucas
*.uasset
*.uexp
*.ubulk
*.usmap
*.jmap
*.sav
*.dmp
*.exe
*.dll
*.pdb
*.log
*.zip
*.7z
*.rar

# retoc may emit this working-directory cache
/pakstore.json
