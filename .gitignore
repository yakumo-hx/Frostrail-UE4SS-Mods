# Local evidence, extracted resources, tools and deliverables
/.local/
/build/
/dist/
/tools/

# Compiler and Python output
**/bin/
**/obj/
__pycache__/
*.py[cod]
.venv/
venv/

# User configuration and captured original values
/mods/*/config.json
/mods/*/original-recipes.json
.env
.env.*
!.env.example

